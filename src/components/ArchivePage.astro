---
import Layout from '@/layouts/Layout.astro';
import { useTranslatedPath, useTranslations } from '@/i18n/utils';
import { POSTS_PER_PAGE, type ArchiveData } from '@/lib/archive';
import PostGrid from '@/components/PostGrid.astro';
import Pagination from '@/components/Pagination.astro';
import Header from '@/components/Header.astro';
import SearchField from '@/components/SearchField.astro';
import StructuredData from '@/components/StructuredData.astro';
import { getCollectionPageSchema } from '@/lib/site-metadata';

interface Props {
  locale: 'en' | 'nl';
  /** Null when the album API is unreachable; the page has already set 503. */
  archive: ArchiveData | null;
}

const { locale, archive } = Astro.props;

// An outage page must not be cached; everything else is shared at the edge.
Astro.response.headers.set(
  'Cache-Control',
  archive ? 'public, s-maxage=300, stale-while-revalidate=86400' : 'no-store'
);

const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const searchParam = archive?.searchTerm ?? '';
const currentPage = archive?.currentPage ?? 1;
const albums = archive?.albums ?? [];
const pagination = archive?.pagination ?? { start: 0, limit: POSTS_PER_PAGE, total: 0 };
const upstreamDown = archive === null;

const totalPages = Math.ceil(pagination.total / POSTS_PER_PAGE);
const archiveRoute = `${translatePath('/archive')}/`;
const collectionPageSchema = getCollectionPageSchema(locale);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://www.behangmotief.be';
const canonicalArchiveUrl = `${siteUrl}${archiveRoute}`;
const isFiltered = Boolean(searchParam);
const isPaginated = currentPage > 1;
---

<Layout
  title={t('archive.title')}
  description={t('archive.description')}
  locale={locale}
  canonicalUrl={canonicalArchiveUrl}
  noindex={isFiltered || isPaginated}
>
  <StructuredData slot="structured-data" schema={collectionPageSchema} />

  <Header />
  <main class="container mx-auto px-4 md:px-0 py-8">
    <h1 class="text-3xl font-bold mb-8">{t('archive.heading')}</h1>
    <SearchField currentSearch={searchParam} archiveRoute={archiveRoute} />

    {upstreamDown ? (
      <div class="text-center py-16">
        <h2 class="text-2xl font-bold mb-4">{t('archive.unavailable.title')}</h2>
        <p class="text-gray-600 max-w-md mx-auto">{t('archive.unavailable.message')}</p>
      </div>
    ) : searchParam && albums.length === 0 ? (
      <div class="text-center py-16">
        <h2 class="text-2xl font-bold mb-4">{t('search.no.results.title')}</h2>
        <p class="text-gray-600 max-w-md mx-auto">
          {t('search.no.results.message').replace('{searchTerm}', searchParam)}
        </p>
      </div>
    ) : (
      <PostGrid posts={albums} priorityCount={4} />
    )}

    <div class="my-12" hidden={upstreamDown}>
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={archiveRoute}
      />
    </div>
  </main>
</Layout>

<script
  is:inline
  type="application/json"
  data-archive-meta
  set:html={JSON.stringify({
    currentPage,
    totalPages,
    searchTerm: searchParam,
    albumCount: albums.length,
    totalAlbums: pagination.total
  })}
/>
<script is:inline>
  // Track archive page view on load
  document.addEventListener('DOMContentLoaded', () => {
    const metaEl = document.querySelector('[data-archive-meta]');
    if (metaEl) {
      try {
        const meta = JSON.parse(metaEl.textContent || '{}');
        window.posthog?.capture('archive_page_viewed', {
          current_page: meta.currentPage,
          total_pages: meta.totalPages,
          search_term: meta.searchTerm || null,
          album_count: meta.albumCount,
          total_albums: meta.totalAlbums,
          has_search: Boolean(meta.searchTerm)
        });
      } catch (e) {
        // Silently fail if JSON parsing fails
      }
    }
  });
</script>
