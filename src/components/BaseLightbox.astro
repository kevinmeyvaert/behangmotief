---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

export interface LightboxImage {
  id?: string;
  url: string;
  alt: string;
  blurhash?: string;
  width?: number;
  height?: number;
}

interface Props {
  images: LightboxImage[];
  enableNavigation?: boolean;
  enableUrlParams?: boolean;
  triggerSelector?: string;
}

const {
  images,
  enableNavigation = false,
  enableUrlParams = false,
  triggerSelector = '[data-lightbox-trigger]',
} = Astro.props;

const t = useTranslations(getLangFromUrl(Astro.url));
const showNavigation = enableNavigation && images.length > 1;
const buttonClass = 'absolute text-white hover:text-gray-300 p-2 cursor-pointer z-10';
const iconPaths = {
  close: 'M6 18L18 6M6 6l12 12',
  previous: 'M15.75 19.5L8.25 12l7.5-7.5',
  next: 'M8.25 4.5l7.5 7.5-7.5 7.5',
};
---

<div data-lightbox-container>
  <script
    is:inline
    type="application/json"
    data-lightbox-data
    set:html={JSON.stringify({ images, enableNavigation, enableUrlParams, triggerSelector })}
  />
  <dialog
    class="m-0 p-0 w-full h-full max-w-none max-h-none bg-black/90 backdrop:bg-transparent outline-none"
    tabindex="-1"
    data-lightbox-overlay
  >
    <button class={`${buttonClass} top-4 right-4`} data-lightbox-close aria-label={t('lightbox.close')}>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths.close}></path>
      </svg>
    </button>

    {showNavigation && (
      <>
        <button class={`${buttonClass} left-4 top-1/2 -translate-y-1/2`} data-lightbox-prev aria-label={t('lightbox.previous')}>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths.previous}></path>
          </svg>
        </button>
        <button class={`${buttonClass} right-4 top-1/2 -translate-y-1/2`} data-lightbox-next aria-label={t('lightbox.next')}>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths.next}></path>
          </svg>
        </button>
      </>
    )}

    <div class="relative flex items-center justify-center w-full h-full p-4" data-lightbox-stage>
      <div class="relative w-auto h-auto">
        {images[0]?.blurhash && (
          <div class="absolute inset-0 flex items-center justify-center" data-lightbox-blurhash>
            <div class="bg-center bg-cover bg-no-repeat transition-opacity duration-300"></div>
          </div>
        )}
        <div class="absolute inset-0 flex items-center justify-center z-10" data-lightbox-spinner>
          <div class="animate-spin rounded-full h-10 w-10 border-2 border-white/20 border-t-white"></div>
        </div>
        <img
          alt=""
          class="relative max-h-[90vh] max-w-[90vw] w-auto h-auto object-contain opacity-0 transition-opacity duration-300"
          data-lightbox-image
        />
      </div>
    </div>
  </dialog>
</div>

<script>
  import { decode } from 'blurhash';

  interface LightboxConfig {
    images: {
      id?: string;
      url: string;
      alt: string;
      blurhash?: string;
      width?: number;
      height?: number;
    }[];
    enableNavigation: boolean;
    enableUrlParams: boolean;
    triggerSelector: string;
  }

  type LightboxImage = LightboxConfig['images'][number];

  const BLURHASH_SIZE = 32;

  function fitToViewport(width: number, height: number) {
    const maxWidth = window.innerWidth * 0.9;
    const maxHeight = window.innerHeight * 0.9;
    const scale = Math.min(maxWidth / width, maxHeight / height);
    return { width: width * scale, height: height * scale };
  }

  function initLightbox(container: Element) {
    const dataEl = container.querySelector('[data-lightbox-data]');
    const overlay = container.querySelector<HTMLDialogElement>('[data-lightbox-overlay]');
    const stage = container.querySelector('[data-lightbox-stage]');
    const img = container.querySelector<HTMLImageElement>('[data-lightbox-image]');
    if (!dataEl?.textContent || !overlay || !img) return;

    const { images, enableNavigation, enableUrlParams, triggerSelector } =
      JSON.parse(dataEl.textContent) as LightboxConfig;
    const spinner = container.querySelector<HTMLElement>('[data-lightbox-spinner]');
    const blurhashDiv = container.querySelector<HTMLElement>('[data-lightbox-blurhash] div');
    let currentIndex = 0;

    const isOpen = () => overlay.open;
    const indexOfId = (id: string | null) => (id ? images.findIndex((image) => image.id === id) : -1);

    const setUrl = (imageId?: string) => {
      if (!enableUrlParams) return;
      const url = new URL(window.location.href);
      if (imageId) url.searchParams.set('image', imageId);
      else url.searchParams.delete('image');
      window.history.pushState({}, '', url);
    };

    const showBlurhash = (image: LightboxImage) => {
      if (!blurhashDiv || !image.blurhash || !image.width || !image.height) return;
      try {
        const pixels = decode(image.blurhash, BLURHASH_SIZE, BLURHASH_SIZE);
        const canvas = document.createElement('canvas');
        canvas.width = BLURHASH_SIZE;
        canvas.height = BLURHASH_SIZE;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const imageData = ctx.createImageData(BLURHASH_SIZE, BLURHASH_SIZE);
        imageData.data.set(pixels);
        ctx.putImageData(imageData, 0, 0);

        const size = fitToViewport(image.width, image.height);
        blurhashDiv.style.width = `${size.width}px`;
        blurhashDiv.style.height = `${size.height}px`;
        blurhashDiv.style.backgroundImage = `url(${canvas.toDataURL()})`;
        blurhashDiv.classList.remove('opacity-0');
      } catch {
        // An invalid blurhash only costs the placeholder.
      }
    };

    // Shows an image without touching history, so popstate can reuse it.
    const show = (index: number) => {
      currentIndex = index;
      const image = images[index];
      if (!overlay.open) {
        overlay.showModal();
        // Focus the dialog itself so opening it doesn't put a focus ring on the close button.
        overlay.focus();
      }
      if (spinner) spinner.style.display = 'flex';
      img.classList.add('opacity-0');
      document.body.style.overflow = 'hidden';
      img.src = image.url;
      img.alt = image.alt;
      showBlurhash(image);
    };

    const hide = () => {
      overlay.close();
      document.body.style.overflow = '';
      img.removeAttribute('src');
    };

    const open = (index: number) => {
      show(index);
      setUrl(images[index].id);
      window.posthog?.capture('lightbox_opened', {
        image_id: images[index].id,
        image_index: index,
        total_images: images.length,
      });
    };

    const close = () => {
      hide();
      setUrl();
    };

    const step = (direction: 1 | -1) => {
      const newIndex = (currentIndex + direction + images.length) % images.length;
      window.posthog?.capture('lightbox_navigated', {
        direction: direction === 1 ? 'next' : 'previous',
        from_index: currentIndex,
        to_index: newIndex,
        total_images: images.length,
      });
      open(newIndex);
    };

    img.addEventListener('load', () => {
      if (spinner) spinner.style.display = 'none';
      img.classList.remove('opacity-0');
      blurhashDiv?.classList.add('opacity-0');
    });

    document.querySelectorAll(triggerSelector).forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        const imageId = trigger.getAttribute('data-image-id');
        const triggerIndex = imageId ? indexOfId(imageId) : index;
        if (triggerIndex !== -1) open(triggerIndex);
      });
    });

    container.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
    container.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => step(-1));
    container.querySelector('[data-lightbox-next]')?.addEventListener('click', () => step(1));
    // Clicking anywhere beside the photo closes, like the Escape key.
    overlay.addEventListener('click', (event) => {
      if (event.target === overlay || event.target === stage) close();
    });
    overlay.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    overlay.addEventListener('keydown', (event) => {
      if (enableNavigation && event.key === 'ArrowLeft') step(-1);
      else if (enableNavigation && event.key === 'ArrowRight') step(1);
    });

    if (!enableUrlParams) return;

    window.addEventListener('popstate', () => {
      const index = indexOfId(new URLSearchParams(window.location.search).get('image'));
      if (index !== -1) show(index);
      else if (isOpen()) hide();
    });

    const initialIndex = indexOfId(new URLSearchParams(window.location.search).get('image'));
    // Shared link to an image: open it without pushing a duplicate history entry.
    if (initialIndex !== -1) show(initialIndex);
  }

  document.querySelectorAll('[data-lightbox-container]').forEach(initLightbox);
</script>
