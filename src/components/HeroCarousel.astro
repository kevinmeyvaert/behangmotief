---
import BlurHashImage from './BlurHashImage.astro';

interface Props {
  images: {
    src: string;
    alt: string;
    blurhash: string;
  }[];
}

const { images } = Astro.props;
---

<div class="w-full h-full overflow-hidden relative" data-carousel>
  <div class="h-full flex transition-transform duration-500 ease-out motion-reduce:transition-none" data-carousel-track>
    {
      images.map((image, index) => (
        <div class="w-full h-full flex-none">
          <div class="relative h-full">
            <BlurHashImage
              src={image.src}
              alt={image.alt}
              blurhash={image.blurhash}
              width={2500}
              height={2500}
              layout="full-width"
              priority={index === 0}
              containerClass="w-full h-full"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-black/30" />
          </div>
        </div>
      ))
    }
  </div>
  <button
    class="absolute top-1/2 -translate-y-1/2 left-4 bg-white/70 hover:bg-white/90 rounded-full p-2 transition cursor-pointer"
    data-carousel-prev
    aria-label="Previous slide"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="w-6 h-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M15.75 19.5L8.25 12l7.5-7.5"></path>
    </svg>
  </button>
  <button
    class="absolute top-1/2 -translate-y-1/2 right-4 bg-white/70 hover:bg-white/90 rounded-full p-2 transition cursor-pointer"
    data-carousel-next
    aria-label="Next slide"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="w-6 h-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
    </svg>
  </button>
</div>

<script>
  const AUTOPLAY_MS = 4000;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function initCarousel(element: HTMLElement) {
    const track = element.querySelector<HTMLElement>('[data-carousel-track]');
    const prevButton = element.querySelector('[data-carousel-prev]');
    const nextButton = element.querySelector('[data-carousel-next]');
    if (!track || !prevButton || !nextButton) return;

    const slideCount = track.children.length;
    let currentIndex = 0;
    let autoplay: ReturnType<typeof setInterval> | undefined;
    // Once a visitor picks a slide, the carousel stays where they put it.
    let userNavigated = false;

    const goToSlide = (index: number) => {
      currentIndex = (index + slideCount) % slideCount;
      track.style.transform = `translateX(${-currentIndex * 100}%)`;
    };

    const stopAutoplay = () => {
      clearInterval(autoplay);
      autoplay = undefined;
    };

    const startAutoplay = () => {
      if (autoplay || userNavigated || reducedMotion.matches) return;
      autoplay = setInterval(() => goToSlide(currentIndex + 1), AUTOPLAY_MS);
    };

    const navigate = (direction: 1 | -1) => {
      const fromIndex = currentIndex;
      userNavigated = true;
      stopAutoplay();
      goToSlide(currentIndex + direction);
      window.posthog?.capture('carousel_navigated', {
        direction: direction === 1 ? 'next' : 'previous',
        from_index: fromIndex,
        to_index: currentIndex,
        total_slides: slideCount,
      });
    };

    prevButton.addEventListener('click', () => navigate(-1));
    nextButton.addEventListener('click', () => navigate(1));
    element.addEventListener('mouseenter', stopAutoplay);
    element.addEventListener('mouseleave', startAutoplay);
    reducedMotion.addEventListener('change', () => (reducedMotion.matches ? stopAutoplay() : startAutoplay()));

    startAutoplay();
  }

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
</script>
