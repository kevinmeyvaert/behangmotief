---
import { Image } from 'astro:assets';
import BaseLightbox, { type LightboxImage } from './BaseLightbox.astro';

interface Props {
  imageSrc: string;
  imageAlt: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  imageSrc,
  imageAlt,
  imageWidth = 2500,
  imageHeight = 1513,
} = Astro.props;

const lightboxImage: LightboxImage = {
  url: imageSrc,
  alt: imageAlt
};
---

<div class="image-lightbox">
  <div class="w-full cursor-zoom-in" data-lightbox-trigger>
    <Image
      src={imageSrc}
      alt={imageAlt}
      class="w-full h-auto"
      width={imageWidth}
      height={imageHeight}
    />
  </div>
  <BaseLightbox
    images={[lightboxImage]}
    enableNavigation={false}
    enableUrlParams={false}
    triggerSelector=".image-lightbox [data-lightbox-trigger]"
  />
</div>
