---
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from '../i18n/utils';
import LanguagePicker from './LanguagePicker.astro';
import { withTrailingSlash } from '@/lib/url';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
const translatePath = useTranslatedPath(lang);
const homePath = `/${lang}/`;
const archivePath = translatePath('archive');
const albumPath = translatePath('album');
const normalizedCurrentPath = withTrailingSlash(currentPath);

const isHomeActive = normalizedCurrentPath === homePath;

const isArchiveActive =
  normalizedCurrentPath === archivePath ||
  normalizedCurrentPath.startsWith(archivePath) ||
  normalizedCurrentPath.startsWith(albumPath);
---

<nav>
  <div class="hidden md:flex gap-8 items-center">
    <a
      href={homePath}
      class={`${theme === 'dark' ? 'text-white' : 'text-black'} hover:opacity-70 transition-opacity ${isHomeActive ? 'border-b-2 border-current' : ''}`}
    >
      {t('nav.home')}
    </a>
    <a
      href={archivePath}
      class={`${theme === 'dark' ? 'text-white' : 'text-black'} hover:opacity-70 transition-opacity ${isArchiveActive ? 'border-b-2 border-current' : ''}`}
    >
      {t('nav.archive')}
    </a>
    <LanguagePicker theme={theme} />
  </div>

  <!-- Mobile Menu Button -->
  <button
    id="mobile-menu-button"
    class="md:hidden"
    aria-label={t('nav.menu.open')}
    aria-controls="mobile-menu"
    aria-expanded="false"
  >
    <svg
      class={`w-8 h-8 ${theme === 'dark' ? 'text-white' : 'text-black'}`}
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <!-- Mobile Menu -->
  <dialog
    id="mobile-menu"
    aria-label={t('nav.menu')}
    class="md:hidden m-0 p-0 w-full h-full max-w-none max-h-none bg-transparent backdrop:bg-transparent"
  >
    <div
      class={`fixed inset-0 ${theme === 'dark' ? 'bg-gray-900' : 'bg-white'} p-6 transform transition-transform duration-300 translate-x-full`}
    >
      <button
        id="close-menu-button"
        class="absolute top-6 right-6"
        aria-label={t('nav.menu.close')}
      >
        <svg
          class={`w-8 h-8 ${theme === 'dark' ? 'text-white' : 'text-black'}`}
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      <div class="flex flex-col items-center justify-center h-full">
        <div class="flex flex-col space-y-8 text-2xl -mt-16 text-center">
          <a
            href={homePath}
            class={`${theme === 'dark' ? 'text-white' : 'text-black'} hover:opacity-70 transition-opacity ${isHomeActive ? 'font-bold' : ''}`}
          >
            {t('nav.home')}
          </a>
          <a
            href={archivePath}
            class={`${theme === 'dark' ? 'text-white' : 'text-black'} hover:opacity-70 transition-opacity ${isArchiveActive ? 'font-bold' : ''}`}
          >
            {t('nav.archive')}
          </a>
          <div>
            <LanguagePicker theme={theme} />
          </div>
        </div>
      </div>
    </div>
  </dialog>
</nav>

<script>
  const openButton = document.getElementById('mobile-menu-button');
  const closeButton = document.getElementById('close-menu-button');
  const menu = document.getElementById('mobile-menu');
  const panel = menu?.querySelector('div');

  if (openButton && closeButton && menu instanceof HTMLDialogElement && panel) {
    const SLIDE_MS = 300;
    const setScrollLock = (locked: boolean) => {
      document.documentElement.style.overflow = locked ? 'hidden' : '';
      document.body.style.overflow = locked ? 'hidden' : '';
    };

    // showModal traps focus, makes the page behind inert and closes on Escape.
    const openMenu = () => {
      menu.showModal();
      openButton.setAttribute('aria-expanded', 'true');
      setScrollLock(true);
      requestAnimationFrame(() => panel.classList.remove('translate-x-full'));
    };

    const closeMenu = () => {
      panel.classList.add('translate-x-full');
      openButton.setAttribute('aria-expanded', 'false');
      setScrollLock(false);
      setTimeout(() => menu.close(), SLIDE_MS);
    };

    openButton.addEventListener('click', openMenu);
    closeButton.addEventListener('click', closeMenu);
    menu.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeMenu();
    });
  }
</script>
