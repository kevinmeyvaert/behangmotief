---
import { getLangFromUrl, useTranslatedPath } from '@/i18n/utils';
import AlbumCard from './AlbumCard.astro';
import { formatPostDate } from '@/lib/date';
import type { AlbumPost } from '@/types/components';

interface Props {
  /** How many leading thumbnails to treat as LCP candidates. */
  priorityCount?: number;
  posts: AlbumPost[];
}

const { posts, priorityCount = 0 } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const albumBasePath = translatePath('/album');
---

<div class="columns-1 md:columns-2 lg:columns-3 gap-6">
  {
    posts.map((post, index) => (
      <AlbumCard
        post={post}
        href={`${albumBasePath}${post.slug}/`}
        title={post.artist.name}
        subtitle={`${post.venue.name} — ${formatPostDate(post.date)}`}
        priority={index < priorityCount}
        class="block break-inside-avoid mb-6"
      />
    ))
  }
</div>
