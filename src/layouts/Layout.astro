---
import Footer from '@/components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import StructuredData from '@/components/StructuredData.astro';
import PostHog from '@/components/PostHog.astro';
import '../styles/global.css';
import { getAlternateUrls, localeToHreflang } from '@/i18n/utils';
import { OG_IMAGE_HEIGHT, OG_IMAGE_TYPE, OG_IMAGE_WIDTH, ogImageUrl } from '@/lib/og';
import { defaultLang } from '@/i18n/ui';
import { withTrailingSlash } from '@/lib/url';
import { SITE_URL } from '@/lib/consts';
import {
  getPersonSchema,
  getOrganizationSchema,
  getWebSiteSchema,
} from '@/lib/site-metadata';

interface Props {
  title: string;
  description: string;
  locale: string;
  canonicalUrl?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Photo to use as the share card background. Omit for the brand default. */
  ogImageSrc?: string;
  ogImageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  locale,
  canonicalUrl,
  noindex = false,
  ogType = 'website',
  ogImageSrc,
  ogImageAlt,
  publishedTime,
  modifiedTime,
} = Astro.props;
const alternateUrls = getAlternateUrls(Astro.url, SITE_URL);

// Generate base structured data for all pages
const lang = locale.split('-')[0] as 'nl' | 'en';
const defaultCanonicalUrl = `${SITE_URL}${withTrailingSlash(Astro.url.pathname)}`;
const resolvedCanonicalUrl = canonicalUrl
  ? new URL(canonicalUrl, SITE_URL).toString()
  : defaultCanonicalUrl;
const robotsContent = noindex ? 'noindex,follow' : 'index,follow';
const ogLocale = localeToHreflang[lang].replace('-', '_');
const ogLocaleAlternates = Object.values(localeToHreflang)
  .filter((value) => value !== localeToHreflang[lang])
  .map((value) => value.replace('-', '_'));
const htmlLang = localeToHreflang[lang] || locale;
const resolvedOgImage = new URL(ogImageUrl(ogImageSrc), SITE_URL).toString();
const resolvedOgImageAlt = ogImageAlt
  || (lang === 'nl'
    ? 'Behangmotief portfolio van muziek- en festivalfotografie'
    : 'Behangmotief music and festival photography portfolio');
// x-default is a per-page fallback, so it has to be this page's default-locale
// URL — pointing every page at the homepage invalidates the hreflang cluster.
const xDefaultUrl =
  alternateUrls[localeToHreflang[defaultLang]] ?? `${SITE_URL}/${defaultLang}/`;

const baseStructuredData = [
  getPersonSchema(lang),
  getOrganizationSchema(lang),
  getWebSiteSchema(lang),
];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={resolvedCanonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    <meta property="og:site_name" content="Behangmotief" />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((value) => (
      <meta property="og:locale:alternate" content={value} />
    ))}
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:type" content={OG_IMAGE_TYPE} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    {/* Hreflang tags for language variants */}
    {Object.entries(alternateUrls).map(([hreflang, url]) => (
      <link rel="alternate" hreflang={hreflang} href={url} />
    ))}
    {/* x-default pointing to this page's Dutch variant */}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    {/* Base structured data: Person, Organization, WebSite */}
    <StructuredData schema={baseStructuredData} />

    {/* Allow page-specific structured data via slot */}
    <slot name="structured-data" />

    {/* PostHog analytics */}
    <PostHog />
  </head>
  <body>
    <slot />
    <Footer />
    <Analytics />
    <SpeedInsights />
  </body>
</html>

