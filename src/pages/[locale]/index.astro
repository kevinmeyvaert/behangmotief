---
import Layout from "../../layouts/Layout.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";
import HeroCarousel from "@/components/HeroCarousel.astro";
import ImageLightbox from "@/components/ImageLightbox.astro";
import RecentWork from "@/components/RecentWork.astro";
import { Image } from "astro:assets";
import ProjectCard from "@/components/ProjectCard.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import StructuredData from "@/components/StructuredData.astro";
import Header from "@/components/Header.astro";
import { getProfessionalServiceSchema } from "@/lib/site-metadata";
import { heroImages, projects, serviceCards } from "@/data/homepage";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "nl" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Generate homepage-specific structured data
const professionalServiceSchema = getProfessionalServiceSchema(
  lang as "nl" | "en"
);

export const prerender = true;
---

<Layout
  title={t("landing.title")}
  description={t("landing.description")}
  locale={lang}
>
  <StructuredData slot="structured-data" schema={professionalServiceSchema} />

  <div class="w-full min-h-screen flex flex-col scroll-smooth">
    <Header theme="dark" absolute />
    <main class="flex-grow">
      {/* Hero Section */}
      <section class="relative h-[100svh] flex items-center justify-center">
        <div class="absolute inset-0 z-0">
          <HeroCarousel images={heroImages} />
        </div>
        <div
          class="z-10 text-center text-white px-4 absolute bottom-0 left-0 right-0 pb-16"
        >
          <h1 class="text-3xl md:text-4xl font-bold mb-2">
            {t("hero.title")}
          </h1>
          <p class="text-md md:text-xl mb-8">
            {t("hero.subtitle")}
          </p>
          <a
            href="#about"
            data-scroll-to="about"
            class="inline-block bg-white text-black px-6 py-3 text-md font-semibold hover:bg-gray-100 transition-colors rounded-lg"
          >
            {t("hero.cta")}
          </a>
        </div>
      </section>
      {/* Split Section */}
      <section
        id="about"
        class="min-h-[100svh] flex items-center justify-center relative"
      >
        <div class="absolute bottom-0 right-0 -z-1 hidden md:block">
          <Image
            src="/corner-element-light.jpg"
            alt=""
            width={350}
            height={350}
            role="presentation"
          />
        </div>
        <div class="container mx-auto px-4 py-16">
          <div class="flex flex-col gap-12">
            <div class="w-full md:w-2/3 mx-auto">
              <ImageLightbox
                imageSrc="/pukkelpop-grid-liggend-klein.jpg"
                imageAlt="Pukkelpop social media grid"
              />
            </div>
            <div class="flex justify-center">
              <div class="max-w-3xl text-center">
                <h2 class="text-3xl font-bold mb-6">
                  {t("about.title")}
                </h2>
                <p class="text-gray-600 mb-6">
                  {t("about.description1")}
                </p>
                <p class="text-gray-600 mb-6">
                  {t("about.description2")}
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>
      {/* Services Section */}
      <section class="bg-gray-100 py-32">
        <div class="container mx-auto text-center px-4 md:px-0">
          <h2
            class="text-3xl font-bold mb-12 border-b-2 border-black inline-block"
          >
            {t("services.title")}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
              serviceCards.map((service) => (
                <ServiceCard
                  title={t(`services.${service.key}.title`)}
                  description={t(`services.${service.key}.description`)}
                  src={service.src}
                  alt={service.alt}
                  blurhash={service.blurhash}
                  imageClass={service.imageClass}
                  imageContainerClass={service.imageContainerClass}
                />
              ))
            }
          </div>
        </div>
      </section>
      {/* Portfolio Grid */}
      <section class="w-full bg-black text-white relative">
        <div class="absolute bottom-0 right-0 z-0">
          <Image
            src="/corner-element.jpg"
            alt=""
            width={350}
            height={350}
            role="presentation"
          />
        </div>
        <div class="absolute bottom-0 left-0 z-0 hidden md:block">
          <Image
            src="/corner-element.jpg"
            alt=""
            width={350}
            height={350}
            style="transform: scaleX(-1);"
            role="presentation"
          />
        </div>
        <div class="py-16 relative z-10">
          <div class="container mx-auto px-4 text-center">
            <h2
              class="text-3xl font-bold mb-12 border-b-2 border-white inline-block"
            >
              {t("portfolio.title")}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {
                projects.map((project) => (
                  <ProjectCard
                    title={project.title}
                    imageUrl={project.imageUrl}
                    searchTerm={project.searchTerm}
                    translatePath={translatePath}
                    blurhash={project.blurhash}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </section>
      {/* Contact Section */}
      <section class="container mx-auto px-4 py-32">
        <div class="max-w-2xl mx-auto text-center">
          <h2
            class="text-3xl font-bold mb-6 border-b-2 border-black inline-block"
          >
            {t("collaborate.title")}
          </h2>
          <p class="text-gray-600 mb-8">
            {t("collaborate.description")}
          </p>
          <iframe
            data-tally-src={lang === "nl"
              ? "https://tally.so/embed/mOpOAK?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
              : "https://tally.so/embed/wdLBAz?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"}
            loading="lazy"
            width="100%"
            height="276"
            title="Contact form"
          ></iframe>
        </div>
      </section>
      {/* Recent Work Section */}
      <RecentWork locale={lang} server:defer />
      <section class="container mx-auto px-4 py-32">
        <div class="max-w-2xl mx-auto text-center">
          <h2
            class="text-3xl font-bold mb-6 border-b-2 border-black inline-block"
          >
            {t("archiveSection.title")}
          </h2>
          <p class="text-gray-600 mb-8">
            {t("archiveSection.description")}
          </p>
          <a
            href={translatePath("/archive")}
            class="inline-block bg-black text-white px-6 py-3 text-md font-semibold hover:bg-gray-800 transition-colors rounded-lg"
          >
            {t("archiveSection.cta")}
          </a>
        </div>
      </section>
    </main>
  </div>
</Layout>

<script is:inline>
  document
    .querySelector('[data-scroll-to="about"]')
    ?.addEventListener("click", (e) => {
      e.preventDefault();
      document.getElementById("about")?.scrollIntoView({ behavior: "smooth" });

      // Track hero CTA click
      window.posthog?.capture('hero_cta_clicked', {
        target_section: 'about'
      });
    });
</script>

<script>
  type TallyApi = {
    loadEmbeds: () => void;
  };

  type TallyWindow = Window & {
    Tally?: TallyApi;
  };

  const tallyWindow = window as TallyWindow;
  const tallyScriptUrl = "https://tally.so/widgets/embed.js";

  const loadTallyEmbeds = () => {
    if (tallyWindow.Tally) {
      tallyWindow.Tally.loadEmbeds();
      return;
    }

    document
      .querySelectorAll<HTMLIFrameElement>("iframe[data-tally-src]:not([src])")
      .forEach((iframe) => {
        const source = iframe.dataset.tallySrc;
        if (source) {
          iframe.src = source;
        }
      });
  };

  if (tallyWindow.Tally) {
    loadTallyEmbeds();
  } else if (!document.querySelector(`script[src="${tallyScriptUrl}"]`)) {
    const script = document.createElement("script");
    script.src = tallyScriptUrl;
    script.onload = loadTallyEmbeds;
    script.onerror = loadTallyEmbeds;
    document.body.appendChild(script);
  }
</script>
